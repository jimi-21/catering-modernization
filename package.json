{
  "name": "catering-modernization",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A production-ready catering website modernization demo with CMS, SEO and legacy migration tooling.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:load": "node scripts/load-check.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "npm run db:push && npm run db:seed",
    "db:migrate:postgres": "prisma migrate deploy --schema prisma/schema.postgresql.prisma",
    "migrate:legacy": "tsx scripts/migrate-legacy.ts",
    "capture:screenshots": "tsx scripts/capture-screenshots.ts",
    "audit:lighthouse": "npx lighthouse https://localhost --quiet --max-wait-for-load=60000 --chrome-flags=\"--headless --ignore-certificate-errors --disable-dev-shm-usage --disable-gpu --no-sandbox\" --output=json --output=html --output-path=reports/lighthouse-mobile",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@oddbird/popover-polyfill": "^0.7.3",
    "@prisma/client": "^6.19.0",
    "lucide-react": "^1.74.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^6.19.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
